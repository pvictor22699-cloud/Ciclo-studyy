# ── backend ───────────────────────────────────────────────────────────
# memory  = tudo em RAM, com aluno/professor de demonstração (dev e testes)
# supabase = banco real
BACKEND=memory
PORT=3000

# ── Supabase (preencher depois de criar o projeto) ────────────────────
# SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# SUPABASE_ANON_KEY=eyJ...            # chave pública (login)
# SUPABASE_SERVICE_ROLE_KEY=eyJ...    # chave secreta — SÓ no servidor, nunca no front

# permite ?today=YYYY-MM-DD pra simular datas (deixe false em produção)
ALLOW_TODAY_OVERRIDE=false

# CORS: origem do front, se ele estiver hospedado separado da API
# CORS_ORIGIN=https://ciclo-study.vercel.app
